  "python_developer": [
    {
      "id": "py_1",
      "text": "Can you explain the difference between lists and tuples in Python?",
      "difficulty": "Easy",
      "keywords": [
        "mutable",
        "immutable",
        "syntax",
        "memory",
        "performance",
        "hashable",
        "ordered"
      ],
      "tips": "Address mutability, memory allocation (fixed-size over-allocation in lists), performance, and hashability for dict keys.",
      "model_answer": "Lists are mutable sequences defined with square brackets that can be dynamically resized in place, whereas tuples are immutable sequences defined with parentheses whose elements cannot be modified once instantiated. Because tuples are fixed in size, Python optimizes them with tighter memory blocks and faster allocation. Tuples containing only hashable elements can serve as dictionary keys or set members, whereas mutable lists cannot."
    },
    {
      "id": "py_2",
      "text": "What are Python decorators and how do they work? Give an example use case.",
      "difficulty": "Medium",
      "keywords": [
        "wrapper",
        "closure",
        "higher-order",
        "function",
        "syntax",
        "AOP",
        "logging",
        "authentication",
        "functools"
      ],
      "tips": "Explain that functions are first-class objects, closures wrap behavior, and functools.wraps preserves metadata.",
      "model_answer": "In Python, functions are first-class citizens. A decorator is a higher-order function that takes another function as an argument, extends or alters its behavior using an internal wrapper closure, and returns the modified callable without altering the original source code. Using the @decorator syntax is syntactic sugar for func = decorator(func). A quintessential use case is request authentication or timing metrics where functools.wraps preserves docstrings and function metadata."
    },
    {
      "id": "py_3",
      "text": "Explain the Global Interpreter Lock (GIL) in Python and its implications for multithreading.",
      "difficulty": "Hard",
      "keywords": [
        "GIL",
        "thread",
        "CPython",
        "parallelism",
        "I/O bound",
        "CPU bound",
        "multiprocessing",
        "concurrency",
        "race condition"
      ],
      "tips": "Clarify that GIL is specific to CPython memory management (reference counting), explain I/O-bound vs CPU-bound implications.",
      "model_answer": "The Global Interpreter Lock (GIL) is a mutex in CPython that prevents multiple native OS threads from executing Python bytecode simultaneously, protecting CPython's reference counting memory management from race conditions. As a result, multithreading in Python provides concurrency for I/O-bound tasks (network requests, disk I/O) where threads release the GIL while waiting. However, for CPU-bound computations, true multi-core parallelism requires multiprocessing, external C-extensions, or sub-interpreters."
    }
  ],
